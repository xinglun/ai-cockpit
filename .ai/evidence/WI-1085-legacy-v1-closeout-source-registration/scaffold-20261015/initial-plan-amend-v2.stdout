{
  "changeId": "wi1085-initial-reviewed-plan-v2-20261015",
  "changedValues": [
    {
      "newValue": "旧 v1 closeout 的显式现时来源登记与保全",
      "oldValue": null,
      "operation": "set",
      "path": "/title"
    },
    {
      "newValue": {
        "businessGoal": "为完整可验证的旧 v1 closeout 建立逐工作项、显式且保留历史的现时来源登记；登记义务存在时，必需证据丢失或损坏不得继续释放关闭状态与 scope。",
        "constraints": [
          "完整原始字节及全部适用 payload/依赖均可验证；无来源返回 provenance_unknown。",
          "当前操作者仅 explicit_attestation，不重新认证旧 producer；全部本地来源丢失不可识别。",
          "root 和 extension 的中断恢复仅同 binding/准确原 bytes；单一权威 finalization 写入核心、同 WI lifecycle lock。",
          "核心实现等待 Raydot 当前独立审阅结论；当前只准备 scaffold/Contract 和必要远端检查点。"
        ],
        "nonGoals": [
          "Rewriting or silently migrating old v1 receipts, historical producer identity/time, archive/Contract/close/verification/provider bytes, or representing historical verification as current execution.",
          "Remote trusted monotonic registry, new external trust service, bulk migration, and claims that total loss or rollback of all local provenance is detectable.",
          "Actual source registration or historical repair of real WI-1004 records; this implementation uses isolated fixtures until a separate exact target authority exists.",
          "WI-1084 reopening, PR1040 body changes, WI-1078 retained resources/evidence, other worktrees or dirty files, local Sentinel, Task9, and global Agent/MCP/security/permission configuration.",
          "Release publication, tags, new PR creation without direction, Ready/merge, human close, branch/worktree deletion or resource cleanup.",
          "General finalization, evidence cache or coordination refactoring; unrelated CI/release workflows, assertions or gate weakening."
        ],
        "problem": "Existing readable legacy-v1 recovery evidence has no new v2 origin requirement. Losing all legacy provenance can be indistinguishable from ordinary close; no historical origin may be fabricated. A new explicit present-day registration must remember complete proof obligations while preserving the known total-local-loss boundary and lawful append-only Retained-to-Deleted evolution.",
        "rationale": "将旧 v1 的已知来源丢失边界作为独立新范围，追加现时完整性义务；不重开已完成 WI-1084 或改写历史。",
        "userGoal": "维护者能够对完整旧 v1 证据登记现在核验的来源，并在登记后证据丢失或损坏时获得明确阻断，避免错误释放关闭状态与 scope，同时保留真实历史和合法 Retained→Deleted 追加。"
      },
      "oldValue": "为完整可验证的旧 v1 closeout 建立逐工作项、显式且保留历史的现时来源登记；登记义务存在时，必需证据丢失或损坏不得继续释放关闭状态与 scope。",
      "operation": "replace",
      "path": "/intent"
    },
