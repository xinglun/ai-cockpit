{
  "protocolVersion": 1,
  "oracle": {
    "sourceLock": "reference-source.lock",
    "offline": {
      "mode": "offline-semantic-fixtures",
      "runtimeInvoked": false
    },
    "executable": {
      "mode": "offline-semantic-fixtures",
      "runtimeInvoked": false,
      "adapter": "crates/cockpit-core/tests/conformance.rs",
      "test": "cargo test -p cockpit-core --test conformance -- --test-threads=1",
      "comparison": ["decisionState", "blockers", "unknowns", "safeActions", "requiredChecks", "authority", "outcomeState"]
    },
    "localReference": {
      "mode": "locked-local-reference-runtime",
      "runtimeInvoked": true,
      "adapter": "v1_oracle.py",
      "test": "cargo test -p cockpit-core --test v1_oracle -- --ignored",
      "sourcePathEnv": "AI_COCKPIT_REFERENCE_ROOT",
      "sourceLock": "v1-reference.lock"
    }
  },
  "fixtureLayout": ["repository/", "contract.json", "evidence/", "input.json", "expected.json"],
  "comparison": ["decisionState", "blockers", "unknowns", "safeActions", "requiredChecks", "authority", "outcomeState"],
  "cases": [
    "scope-exceeded",
    "unauthorized-destructive-change",
    "missing-evidence",
    "stale-evidence",
    "contradictory-evidence",
    "unsupported-completion",
    "repository-prompt-injection",
    "malicious-deletion",
    "missing-human-authority",
    "invalid-archive",
    "cross-work-item-evidence",
    "unknown-provider-result",
    "test-weakening",
    "coverage-weakening"
  ]
}
